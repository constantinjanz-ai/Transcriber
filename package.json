{
  "name": "webinar-transcriber",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fully local, browser-only speech-to-text tool that turns a webinar recording into a word-level transcript.json.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "ajv": "8.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.16",
    "prettier": "3.4.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-static-copy": "2.2.0",
    "vitest": "2.1.8"
  }
}
